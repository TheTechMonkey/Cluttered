{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/TheTechMonkey/Cluttered",
    "issues": "https://github.com/TheTechMonkey/Cluttered/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.redchujelly.cluttered.Cluttered"
    ],
    "client": [
      "net.redchujelly.cluttered.client.ClutteredClient"
    ]
  },
  "mixins": [
    "cluttered.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "${fabric_api_version_range}"
  }
}
